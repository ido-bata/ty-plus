# ty-plus runtime configuration. This file is documentation only — it is
# never read by the application and holds no real values. R0's local core
# runs offline and requires none of these; the entries below exist for the
# dormant online surfaces (update / notification / catalog feeds) and for
# release signing. See #11 (cost/secret gate) for the secret policy.

# --- ZXP code-signing certificate password (signing only) ---
# Required for `bun run sign` / `bun run release:zxp`. Not needed for local dev.
ZXP_CERT_PASSWORD=

# --- Online feed endpoints (dormant in R0; no Log!N-era service) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
