# ty-plus runtime configuration is sourced from the self-hosted Infisical
# project `ty-plus`. This file is documentation only — it is never read by
# the application and holds no real values. Use `bun run secrets:run -- <cmd>`
# to inject values into a subprocess, or `bun run setup` for the first-time
# restore. See docs/architecture/cloud/secrets.md for the full schema and
# consumer map.

# --- Notion API + management sync endpoint token (Infisical root `/`, required) ---
NOTION_TOKEN=
SYNC_TOKEN=

# --- ZXP code-signing certificate password (Infisical root `/`, signing only) ---
# Required for `bun run sign` / `bun run release:zxp`. Not needed for local dev.
ZXP_CERT_PASSWORD=

# --- Supabase public configuration (Infisical `/config`, required) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
