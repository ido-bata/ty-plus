{
	"name": "@ty-plus/web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"snapshot:releases": "bun scripts/fetch-release-snapshot.ts",
		"deploy": "npm exec --no -- cf deploy --mode production",
		"deploy:preview": "npm exec --no -- cf deploy --mode preview",
		"cf-typegen": "npm exec --no -- cf build --mode production",
		"deploy:dry-run": "npm exec --no -- cf deploy --mode production --dry-run",
		"deploy:preview:dry-run": "npm exec --no -- cf deploy --mode preview --dry-run"
	},
	"dependencies": {
		"@fontsource-variable/ibm-plex-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/react-start": "1.169.5",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "2.0.0-rc.3",
		"@types/node": "^26.1.2",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "^6.0.5",
		"cf": "1.0.0-rc.1",
		"typescript": "^7.0.2",
		"vite": "8.0.16"
	}
}
