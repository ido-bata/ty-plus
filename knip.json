{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": [
		"package.json",
		"vite.es.config.ts",
		"cep.config.ts",
		"doctor.config.ts",
		"src/management/ae/cep/entry/panel.tsx",
		"src/management/ae/cep/entry/dialog.tsx",
		"src/management/workspace/extendscript/ae-text-layer-scripts.ts",
		"scripts/generate/rust-protocol-schema.ts",
		"scripts/generate/typescript-protocol.ts",
		"src/management/ae/files/runtime-gateway.ts",
		"src/management/storage/runtime-gateway.ts",
		"src/management/ipc/index.ts",
		"src/management/ipc/generated/index.ts",
		"vitest.scenario-spec.config.ts",
		"packages/ui/package.json",
		"apps/web/cloudflare.config.ts",
		"apps/web/scripts/audit-layout.ts",
		"apps/web/scripts/capture-preset-stage.ts",
		"apps/web/scripts/capture-screens.ts",
		"scripts/build/install-cep-bundles.ts",
		"scripts/build/prebuild-clean.ts",
		"scripts/cep/create-cep-bundles.ts",
		"scripts/cep/install-cep-single.ts",
		"scripts/cep/strip-cep-dev-redirect.ts",
		"scripts/cep/validate-built-syntax.ts",
		"scripts/security/install-hooks.ts",
		"scripts/utils/cdp-dump-panels.ts",
		"scripts/verify/device-smoke.ts",
		"scripts/verify/e2e/run.ts",
		"scripts/verify/web-product-capture.ts",
		"scripts/security/pre-commit-security-check.ts"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"scripts/**/*.ts",
		"tools/**/*.ts",
		"*.ts",
		"packages/**/*.{ts,tsx}"
	],
	"ignore": ["**/*.d.ts", "**/node_modules/**"],
	"ignoreBinaries": ["reg", "rustc", "pwsh"],
	"ignoreFiles": [
		"src/management/ae/cep/vendor/**",
		"src/management/ae/jsx/**",
		"scripts/cep/uninstall.ts",
		"scripts/demo/markdown-editor/vite.config.ts",
		"scripts/lib/cep-bundle.ts",
		".storybook/**",
		"storybook-static/**",
		"archive/**",
		"docs/no-use/**",
		"apps/web/cloudflare.config.ts",
		"apps/web/scripts/audit-layout.ts",
		"apps/web/scripts/capture-preset-stage.ts",
		"apps/web/scripts/capture-screens.ts"
	],
	"ignoreIssues": {
		"archive/**": ["files", "unlisted", "unresolved", "exports", "types"],
		"docs/no-use/**": ["files", "unlisted", "unresolved", "exports", "types"]
	},
	"ignoreDependencies": [
		"cf",
		"@babel/plugin-transform-class-properties",
		"@babel/plugin-transform-private-methods",
		"@babel/plugin-transform-private-property-in-object",
		"@babel/preset-env",
		"@babel/preset-typescript",
		"@rollup/pluginutils",
		"@storybook/react",
		"@storybook/react-vite"
	],
	"vite": {
		"config": "vite.config.ts"
	},
	"vitest": {
		"config": "vitest.config.ts"
	}
}
