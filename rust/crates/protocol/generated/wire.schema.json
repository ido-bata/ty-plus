        }
      },
      "required": [
        "state",
        "label",
        "checked_at"
      ],
      "title": "ConnectivityStatusDto",
      "type": "object"
    },
    "generateThumbnailRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Thumbnail-generation request payload for the host thumbnail resolver.\n\nMirrors `LookupThumbnailRequest` so callers can route lookup and generate\nthrough the same identity triple.",
      "properties": {
        "file_type": {
          "type": "string"
        },
        "mtime_ms": {
          "format": "int64",
          "type": "integer"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_path": {
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "mtime_ms",
        "size_bytes",
        "file_type"
      ],
      "title": "GenerateThumbnailRequest",
      "type": "object"
    },
    "generateThumbnailResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Thumbnail-generation response payload for the host thumbnail resolver.\n\n`cache_path` is always populated after a successful generation. The\ngeneration is idempotent over `(mtime, size, sha256)`, so a retry that\nobserves the same identity triple writes the same bytes back.",
      "properties": {
        "animated_source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_path": {
          "type": "string"
        }
      },
      "required": [
        "cache_path"
      ],
      "title": "GenerateThumbnailResponse",
      "type": "object"
    },
    "lookupThumbnailRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Cache-lookup request payload for the host thumbnail resolver.\n\nIdentifies the source media by its host-stable identity triple so the\nruntime can answer whether a cached thumbnail exists without re-reading\nthe source bytes.",
      "properties": {
        "file_type": {
          "type": "string"
        },
        "mtime_ms": {
          "format": "int64",
          "type": "integer"
        },
        "size_bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "source_path": {
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "mtime_ms",
        "size_bytes",
        "file_type"
      ],
      "title": "LookupThumbnailRequest",
      "type": "object"
    },
    "lookupThumbnailResponse": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Cache-lookup response payload for the host thumbnail resolver.\n\n`cache_path` is `None` when no cached thumbnail exists yet for the\nrequested identity. `animated_source_path` is set when the source is an\nanimated media file that the caller may render directly.",
      "properties": {
        "animated_source_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "cache_path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "LookupThumbnailResponse",
      "type": "object"
    },
    "pluginEffectScanRequest": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
