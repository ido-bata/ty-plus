{
	"$schema": "https://biomejs.dev/schemas/2.5/schema.json",
	"vcs": {
		"enabled": false
	},
	"files": {
		"includes": [
			"dist/cep-dev/**/*.html",
			"dist/cep-dev/**/*.cjs",
			"dist/cep-dev/jsx/**/*.jsx",
			"!dist/cep-dev/assets/js/chunks/**",
			"!dist/cep-dev/node_modules/**",
			"!dist/cep-dev/vendor/**",
			"!dist/cep-dev/cep-shell.bundle.css",
			"!dist/cep-dev/**/*.map"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"indentStyle": "tab",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"json": {
		"formatter": {
			"indentStyle": "tab",
			"indentWidth": 2,
			"lineWidth": 100,
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	}
}
