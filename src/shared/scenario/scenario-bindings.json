			],
			"onFailure": {
				"capture": ["screenshot", "log-bus-tail", "persisted-state-dump"],
				"doNot": ["send-to-network", "modify-preset-asset"]
			},
			"automation": {
				"requiredCapabilities": [
					"click",
					"type",
					"selector-resolve",
					"persisted-state-read",
					"computed-style-snapshot",
					"log-bus-read"
				]
			},
			"postconditions": [
				"asset:AuthoredPreset is removed during cleanup.",
				"storage:preset:AuthoredPreset is null."
			],
			"requirement_id": "preset-authoring",
			"verification_rows": ["preset-authoring"]
		}
	]
}
