{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": ["node", "bun"],
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"strict": true
	},
	"include": [
		"scripts/package/release/version.ts",
		"scripts/package/release/manifest.ts",
		"scripts/package/release/prepare-github-release.ts",
		"scripts/package/build/github-release.ts",
		"scripts/verify/release-artifacts.ts",
		"scripts/verify/device-smoke.ts",
		"scripts/verify/device-smoke-cdp.ts",
		"scripts/verify/e2e/**/*.ts",
		"scripts/verify/storybook/capture-metadata.ts",
		"scripts/verify/storybook/screenshot-path.ts",
		"scripts/verify/storybook/capture-merge.ts",
		"scripts/verify/storybook/capture-gallery.ts",
		"scripts/verify/storybook/screenshot-capture.ts",
		"scripts/package/build/platform.ts"
	]
}
