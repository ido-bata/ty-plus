{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": [
			"node",
			"bun",
			"vite/client"
		],
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"strict": true
	},
	"include": [
		"tools/**/*.ts",
		".storybook/**/*.ts",
		"src/vite-env.d.ts",
		"scripts/**/*.ts"
	],
	"exclude": [
		"scripts/utils",
		"scripts/cep"
	]
}
